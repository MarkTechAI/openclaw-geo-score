{
  "name": "openclaw-geo-score",
  "version": "0.1.0",
  "description": "OpenClaw plugin and CLI that scores how ready a web page or draft is to be retrieved and cited by AI answer engines (GEO), with ranked fixes.",
  "type": "module",
  "license": "MIT",
  "author": "tchop GmbH (https://tchop.io)",
  "homepage": "https://github.com/MarkTechAI/openclaw-geo-score#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkTechAI/openclaw-geo-score.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "geo",
    "generative-engine-optimization",
    "ai-search",
    "seo",
    "llm"
  ],
  "main": "./dist/index.js",
  "bin": {
    "geo-score": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "tsc -p tsconfig.json && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "openclaw plugins validate --root . --entry ./dist/index.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "plugin:check": "openclaw plugins build --entry ./dist/index.js --check"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "typebox": "^1.3.36"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "^2026.10.2",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "bugs": {
    "url": "https://github.com/MarkTechAI/openclaw-geo-score/issues"
  }
}
